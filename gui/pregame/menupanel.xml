<?xml version="1.0" encoding="utf-8"?>
<object>

	<object name="pgToolTip" style="TranslucentPanel" type="text" hidden="true" size="100%-290 25 100% 140" ghost="true"/>

	<!-- PS5-style dashboard background -->
	<object name="dashboardBackground" type="image" sprite="DashboardBackground" size="0 0 100% 100%"/>

	<!-- Header: gold emblem + hero title, top-left -->
	<object name="dashboardEmblem" type="image" size="4% 5% 8% 12.1%" sprite="DashboardEmblem" ghost="true"/>
	<object type="text" size="9.5% 4.5% 60% 8%" font="sans-bold-18" textcolor="255 255 255" text_align="left" text_valign="center">
		<translatableAttribute id="caption">Welcome</translatableAttribute>
	</object>
	<object type="text" size="9.5% 8% 60% 15%" font="godseye-bold-44" textcolor="212 175 55" text_align="left" text_valign="center">
		<translatableAttribute id="caption">GOD'S EYE</translatableAttribute>
	</object>
	<object type="text" size="9.5% 15% 60% 18%" font="sans-14" textcolor="160 180 210" text_align="left" text_valign="center">
		<translatableAttribute id="caption">Choose your path, build your legend.</translatableAttribute>
	</object>

	<!-- Section header: gold tick + label, aligned to the card grid -->
	<object type="text" size="18.45% 27.5% 19.6% 30%" font="sans-bold-20" textcolor="212 175 55" text_align="left" text_valign="center">|</object>
	<object type="text" size="20.2% 27.5% 60% 30%" font="sans-bold-16" textcolor="255 255 255" text_align="left" text_valign="center">
		<translatableAttribute id="caption">CHOOSE YOUR PATH</translatableAttribute>
	</object>

	<!-- Main card grid: 2 rows x 5 portrait cards (mockup layout) -->
	<object name="mainMenu" size="0 0 100% 100%">
		<object name="mainMenuButtons" size="0 30% 100% 78.6%">
			<repeat count="10">
				<object name="mainMenuButton[n]" type="button"
					sprite="TransparentButton" sprite_over="TransparentButton" sprite_pressed="TransparentButton" sprite_disabled="TransparentButton"
					textcolor="white" textcolor_disabled="150 150 150" font="sans-bold-13"
					text_align="center" text_valign="bottom"
					buffer_zone="4">
					<object name="mainMenuTileIcon[n]" type="image" size="0% 0% 100% 100%" sprite="DashboardCardArtLearn" ghost="true"/>
					<object name="mainMenuTileDim[n]" type="image" size="0% 0% 100% 100%" sprite="DashboardTileDim" ghost="true" hidden="true"/>
					<object name="mainMenuTileFrame[n]" type="image" size="0% 0% 100% 100%" sprite="DashboardCardFrame" ghost="true"/>
					<object name="mainMenuTileFrameOver[n]" type="image" size="0% 0% 100% 100%" sprite="DashboardCardFrameOver" ghost="true" hidden="true"/>
					<object name="mainMenuTileCaptionShadow[n]" type="text" size="8% 71% 94% 80%"
						font="sans-bold-14" textcolor="0 0 0" text_align="left" text_valign="center" ghost="true"/>
					<object name="mainMenuTileCaption[n]" type="text" size="7% 70% 93% 79%"
						font="sans-bold-14" textcolor="white" text_align="left" text_valign="center" ghost="true"/>
					<object name="mainMenuTileSubtitle[n]" type="text" size="7% 79% 93% 96%"
						font="sans-11" textcolor="160 180 210" text_align="left" text_valign="top" ghost="true"/>
				</object>
			</repeat>
		</object>
	</object>

	<!-- Submenu: floating panel over a dimmed menu -->
	<object name="submenuBackdrop" type="image" size="0 0 100% 100%" sprite="DashboardDim" ghost="true" hidden="true"/>
	<object name="submenu" size="17.5% 42% 82.5% 58%" hidden="true">
		<object name="submenuButtons" size="0 0 100% 100%">
			<repeat count="30">
				<object type="button"
					sprite="DashboardSubcard" sprite_over="DashboardSubcardOver" sprite_pressed="DashboardSubcardOver" sprite_disabled="DashboardSubcard"
					textcolor="white" textcolor_disabled="150 150 150" font="godseye-bold-13"
					text_align="center" text_valign="center"
					buffer_zone="4"/>
			</repeat>
		</object>
	</object>

	<!-- Bottom-center ornament + tagline -->
	<object type="image" size="35% 80.5% 65% 84%" sprite="DashboardOrnament" ghost="true"/>
	<object type="text" size="0 84% 100% 86.5%" font="sans-bold-13" textcolor="212 175 55" text_align="center" text_valign="center">
		<translatableAttribute id="caption">FORGE YOUR LEGEND</translatableAttribute>
	</object>

	<!-- Bottom info bar -->
	<object type="text" size="0 100%-40 100% 100%-12" font="sans-12" textcolor="160 180 220" text_align="center" text_valign="center">
		<translatableAttribute id="caption">God's Eye mod for 0 A.D. 0.28</translatableAttribute>
	</object>

	<!-- 0AD logo: top-right, honoring the base game -->
	<object name="productLogo" type="image" size="100%-120 8 100%-8 64" ghost="true"/>
	<object name="productBuild" type="text" size="100%-120 66 100%-8 82" font="sans-10" textcolor="120 140 180" text_align="right" ghost="true"/>

	<!-- Top-right: quick settings gear -->
	<object name="quickSettingsButton" type="button" size="100%-52 88 100%-8 132"
		sprite="TransparentButton" sprite_over="TransparentButton" sprite_pressed="TransparentButton">
		<object type="image" size="0% 0% 100% 100%" sprite="DashboardIconSettings" ghost="true"/>
	</object>

	<!-- Bottom-right player plate: crown + name -->
	<object type="image" size="100%-212 100%-62 100%-164 100%-14" sprite="DashboardCrown" ghost="true"/>
	<object name="playerPlateName" type="text" size="100%-156 100%-60 100%-12 100%-16" font="sans-bold-13" textcolor="212 175 55" text_align="left" text_valign="center" ghost="true"/>

	<!-- Lobby widget: who's online in the multiplayer lobby (opt-in, display only) -->
	<object name="lobbyWidget" size="12 100%-224 312 100%-48" hidden="true" ghost="true">
		<object name="lobbyWidgetTitle" type="text" size="0 0 100% 24" font="godseye-bold-13" textcolor="212 175 55" text_align="left" text_valign="center" ghost="true"/>
		<object name="lobbyWidgetCount" type="text" size="0 24 100% 46" font="sans-bold-12" textcolor="white" text_align="left" text_valign="center" ghost="true"/>
		<object name="lobbyWidgetNames" type="text" size="0 46 100% 100%" font="sans-11" textcolor="160 180 210" text_align="left" text_valign="top" ghost="true"/>
	</object>

	<!-- Required by MainMenuPage.js (hidden) -->
	<object name="organizationName" type="text" size="0 0 0 0" hidden="true"/>
	<object name="organizationLogo" type="image" size="0 0 0 0" hidden="true"/>
	<object name="productDescription" type="text" size="0 0 0 0" hidden="true"/>
	<object name="communityButtons" size="0 0 0 0" hidden="true">
		<repeat count="6">
			<object type="button" hidden="true"/>
		</repeat>
	</object>

	<!-- Click-catcher to close submenu -->
	<object name="closeMenuButton" type="button" sprite="TransparentButton" hotkey="cancel"/>

	<!-- These are required by MainMenuItemHandler but unused in dashboard mode -->
	<object name="MainMenuPanelRightBorderTop" size="0 0 0 0" hidden="true"/>
	<object name="MainMenuPanelRightBorderBottom" size="0 0 0 0" hidden="true"/>

</object>
