<?xml version="1.0" encoding="utf-8"?>
<object>

	<object name="pgToolTip" style="TranslucentPanel" type="text" hidden="true" size="100%-290 25 100% 140" ghost="true"/>

	<object name="mainMenu" type="image" style="MainMenuPanel" size="60 -2 300 100%+2" z="50">
		<object type="text" size="8 18 100%-8 64" font="godseye-bold-30" textcolor="212 175 55" text_align="center">
			<translatableAttribute id="caption">GOD'S EYE</translatableAttribute>
		</object>

		<object name="mainMenuButtons" size="8 146 100%-8 346">
			<repeat count="10">
				<object name="mainMenuButton[n]" type="button" sprite="GodseyeButton" sprite_over="GodseyeButtonOver" sprite_pressed="GodseyeButtonPressed" sprite_disabled="GodseyeButtonDisabled" style="StoneButtonFancy" tooltip_style="pgToolTip"/>
			</repeat>
		</object>

		<!-- These are used to make the right side blend in with the submenu -->
		<object name="MainMenuPanelRightBorderTop" type="image" sprite="MainMenuPanelRightBorder" ghost="true" size="100%-2 0 100% 100%"/>
		<object name="MainMenuPanelRightBorderBottom" type="image" sprite="MainMenuPanelRightBorder" ghost="true" size="100%-2 0 100% 100%"/>

		<include file="gui/pregame/ProjectInformation.xml"/>
	</object>

	<object name="submenu" type="image" style="SubmenuPanel" size="60 0 300 0%" hidden="true">
		<object name="submenuButtons" type="image" size="0 4 100%-4 100%-4" tooltip_style="pgToolTip">
			<repeat count="30">
				<object type="button" sprite="GodseyeButton" sprite_over="GodseyeButtonOver" sprite_pressed="GodseyeButtonPressed" sprite_disabled="GodseyeButtonDisabled" style="StoneButtonFancy" tooltip_style="pgToolTip"/>
			</repeat>
		</object>
	</object>

	<!-- Hide submenu when user clicks on the background -->
	<object name="closeMenuButton" type="button" sprite="GodseyeButton" sprite_over="GodseyeButtonOver" sprite_pressed="GodseyeButtonPressed" sprite_disabled="GodseyeButtonDisabled" hotkey="cancel"/>

</object>
